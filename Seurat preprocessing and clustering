############################################################
# Supplementary Code
# Single-cell RNA-seq analysis
# Seurat v4.0.4
# Monocle v2.22.0
############################################################

# -----------------------------
# 1. Load packages
# -----------------------------
library(Seurat)
library(Matrix)
library(dplyr)
library(ggplot2)
library(monocle)

set.seed(1234)


# -----------------------------
# 2. Load BD Rhapsody UMI matrix
# -----------------------------
# Replace the paths below with the actual output files generated
# by the BD Rhapsody Whole Transcriptome Assay Analysis Pipeline.

counts <- Read10X(
  data.dir = "path/to/BD_Rhapsody_gene_expression_matrix/"
)

seu <- CreateSeuratObject(
  counts = counts,
  project = "SWCNT_cpGN13",
  min.cells = 3,
  min.features = 0
)


# -----------------------------
# 3. Calculate mitochondrial percentage
# -----------------------------
# Mouse mitochondrial genes generally begin with "mt-".
seu[["percent.mt"]] <- PercentageFeatureSet(
  seu,
  pattern = "^mt-"
)


# -----------------------------
# 4. Quality control
# -----------------------------
# Exclusion criteria:
# mitochondrial UMIs > 25%
# total UMIs < 500
# detected genes < 200

seu <- subset(
  seu,
  subset =
    percent.mt <= 25 &
    nCount_RNA >= 500 &
    nFeature_RNA >= 200
)


# -----------------------------
# 5. Log normalization
# -----------------------------
seu <- NormalizeData(
  seu,
  normalization.method = "LogNormalize",
  scale.factor = 10000,
  verbose = FALSE
)


# -----------------------------
# 6. Identify highly variable genes
# -----------------------------
seu <- FindVariableFeatures(
  seu,
  selection.method = "vst",
  nfeatures = 2000,
  verbose = FALSE
)

variable.genes <- VariableFeatures(seu)


# -----------------------------
# 7. Scale data and regress out total UMI counts
# -----------------------------
seu <- ScaleData(
  seu,
  features = rownames(seu),
  vars.to.regress = "nCount_RNA",
  verbose = FALSE
)


# -----------------------------
# 8. Principal component analysis
# -----------------------------
seu <- RunPCA(
  seu,
  features = variable.genes,
  npcs = 50,
  verbose = FALSE
)

# Optional visualization
ElbowPlot(seu, ndims = 50)


# -----------------------------
# 9. Nearest-neighbor graph and clustering
# -----------------------------
# Adjust dims only if your actual analysis used a different number.
# If 1:20 was used in the original analysis, retain 1:20 here.

seu <- FindNeighbors(
  seu,
  dims = 1:20,
  verbose = FALSE
)

seu <- FindClusters(
  seu,
  resolution = 0.6,
  verbose = FALSE
)


# -----------------------------
# 10. t-SNE
# -----------------------------
seu <- RunTSNE(
  seu,
  dims = 1:20,
  seed.use = 1234,
  check_duplicates = FALSE,
  verbose = FALSE
)

DimPlot(
  seu,
  reduction = "tsne",
  group.by = "seurat_clusters",
  label = TRUE,
  repel = TRUE
)


# -----------------------------
# 11. Identify cluster marker genes
# -----------------------------
markers <- FindAllMarkers(
  seu,
  only.pos = TRUE,
  test.use = "wilcox",
  logfc.threshold = 0.25,
  min.pct = 0.25
)

markers <- markers %>%
  arrange(cluster, desc(avg_log2FC))

write.csv(
  markers,
  file = "Seurat_cluster_markers.csv",
  row.names = FALSE
)


# -----------------------------
# 12. Export cluster markers for SCSA
# -----------------------------
# SCSA can use marker lists from each Seurat cluster.
# Export the marker table for downstream annotation.

write.table(
  markers,
  file = "markers_for_SCSA.txt",
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)


# -----------------------------
# 13. Cell-type annotation
# -----------------------------
# Cell types were first assigned using SCSA v1.1 and then
# manually refined using canonical mouse vascular and immune markers.
#
# Example canonical markers:
#
# Macrophages:
# Adgre1, Cd68, Lgals3, Csf1r
#
# Monocytes:
# Lyz2, Ly6c2, Ccr2, S100a8, S100a9
#
# Neutrophils:
# Ly6g, S100a8, S100a9, Cxcr2
#
# Endothelial cells:
# Pecam1, Cdh5, Kdr, Emcn
#
# Vascular smooth muscle cells:
# Acta2, Tagln, Myh11, Cnn1
#
# Fibroblasts:
# Col1a1, Col1a2, Dcn, Lum
#
# T cells:
# Cd3d, Cd3e, Trbc1
#
# B cells:
# Cd79a, Ms4a1, Cd37


# Example visualization of canonical markers
FeaturePlot(
  seu,
  features = c(
    "Adgre1", "Cd68",
    "Lyz2", "Ly6c2",
    "Pecam1", "Cdh5",
    "Acta2", "Tagln"
  ),
  reduction = "tsne",
  ncol = 4
)


# -----------------------------
# 14. Assign refined cell-type identities
# -----------------------------
# Replace the cluster numbers below with the actual annotations
# obtained from SCSA and canonical marker inspection.

cluster.annotations <- c(
  "0" = "Macrophages",
  "1" = "Endothelial cells",
  "2" = "VSMCs",
  "3" = "Monocytes",
  "4" = "Fibroblasts",
  "5" = "T cells"
)

# Only run after replacing the mapping above with your actual results.
seu <- RenameIdents(
  seu,
  cluster.annotations
)

seu$celltype <- Idents(seu)

DimPlot(
  seu,
  reduction = "tsne",
  group.by = "celltype",
  label = TRUE,
  repel = TRUE
)


# -----------------------------
# 15. Save processed Seurat object
# -----------------------------
saveRDS(
  seu,
  file = "Seurat_processed_object.rds"
)


############################################################
# Pseudotime analysis with Monocle v2.22.0
############################################################

# -----------------------------
# 16. Convert Seurat data for Monocle
# -----------------------------
expression_matrix <- as(
  GetAssayData(
    seu,
    assay = "RNA",
    slot = "counts"
  ),
  "sparseMatrix"
)

cell_metadata <- seu@meta.data

gene_metadata <- data.frame(
  gene_short_name = rownames(expression_matrix),
  row.names = rownames(expression_matrix)
)

pd <- new(
  "AnnotatedDataFrame",
  data = cell_metadata
)

fd <- new(
  "AnnotatedDataFrame",
  data = gene_metadata
)


# -----------------------------
# 17. Create Monocle CellDataSet
# -----------------------------
cds <- newCellDataSet(
  expression_matrix,
  phenoData = pd,
  featureData = fd,
  expressionFamily = negbinomial.size(),
  lowerDetectionLimit = 0.5
)


# -----------------------------
# 18. Estimate size factors and dispersions
# -----------------------------
cds <- estimateSizeFactors(cds)
cds <- estimateDispersions(cds)


# -----------------------------
# 19. Select ordering genes
# -----------------------------
# Use top Seurat cluster marker genes as ordering genes.

ordering.genes <- markers %>%
  filter(p_val_adj < 0.05) %>%
  arrange(p_val_adj, desc(avg_log2FC)) %>%
  pull(gene) %>%
  unique()

# Optional: limit to the top marker genes if the original analysis
# used a restricted number.
#
# ordering.genes <- head(ordering.genes, 1000)

ordering.genes <- intersect(
  ordering.genes,
  rownames(cds)
)

cds <- setOrderingFilter(
  cds,
  ordering.genes
)


# -----------------------------
# 20. Dimensionality reduction with DDRTree
# -----------------------------
cds <- reduceDimension(
  cds,
  max_components = 2,
  method = "DDRTree"
)


# -----------------------------
# 21. Order cells along pseudotime
# -----------------------------
cds <- orderCells(cds)


# -----------------------------
# 22. Plot trajectory
# -----------------------------
plot_cell_trajectory(
  cds,
  color_by = "celltype"
)

plot_cell_trajectory(
  cds,
  color_by = "Pseudotime"
)


# -----------------------------
# 23. Save Monocle object
# -----------------------------
saveRDS(
  cds,
  file = "Monocle2_pseudotime_object.rds"
)


############################################################
# Additional visualization
############################################################

# Violin plots
VlnPlot(
  seu,
  features = c("Gnas"),
  group.by = "celltype",
  pt.size = 0
)

# Feature plot
FeaturePlot(
  seu,
  features = "Gnas",
  reduction = "tsne"
)

# Heatmap of top cluster markers
top10 <- markers %>%
  group_by(cluster) %>%
  slice_max(
    order_by = avg_log2FC,
    n = 10,
    with_ties = FALSE
  )

DoHeatmap(
  seu,
  features = unique(top10$gene),
  group.by = "seurat_clusters"
)
